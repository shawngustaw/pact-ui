# Runtime configuration, including any Broker base path. Reachable from the app server.
PACT_BROKER_URL=http://host.docker.internal:9292
# Optional additional full Broker URLs selectable in Connection settings, comma-separated.
PACT_BROKER_ALLOWED_URLS=
# Explicit captured-data preview; never used as a fallback for failed live requests.
PACT_UI_DEMO=false
# Each user enters their own credentials in the UI. No shared credentials are configured here.
