  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact primary action; outline is the default API variant.",
      "html": "<button class=\"ds-button-primary\">Inspect contract</button>",
      "css": ".ds-button-primary{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;height:34px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:5px;padding:0 12px;font-weight:500;cursor:pointer;transition:background-color .12s;background:var(--accent);color:var(--surface);}.ds-button-primary:hover{filter:brightness(.95);}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}:host-context([data-theme=\"dark\"]) .ds-button-primary{color:#151626;}@media(max-width:680px){.ds-button-primary{min-height:40px;}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Compact outline action; outline is the default API variant.",
      "html": "<button class=\"ds-button-outline\">Inspect contract</button>",
      "css": ".ds-button-outline{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;height:34px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:5px;padding:0 12px;font-weight:500;cursor:pointer;transition:background-color .12s;background:var(--surface);color:var(--text);border-color:var(--border);}.ds-button-outline:hover{background:var(--surface-hover);}.ds-button-outline:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(max-width:680px){.ds-button-outline{min-height:40px;}}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none;}}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Compact ghost action; outline is the default API variant.",
      "html": "<button class=\"ds-button-ghost\">Inspect contract</button>",
      "css": ".ds-button-ghost{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;height:34px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:5px;padding:0 12px;font-weight:500;cursor:pointer;transition:background-color .12s;background:transparent;color:var(--muted);}.ds-button-ghost:hover{background:var(--surface-hover);color:var(--text);}.ds-button-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(max-width:680px){.ds-button-ghost{min-height:40px;}}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none;}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled standard field with an accent focus ring.",
      "html": "<label for=\"ds-version\">Consumer version</label><input id=\"ds-version\" class=\"ds-input\" placeholder=\"Version or branch\" />",
      "css": ".ds-input{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;height:36px;padding:0 10px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:5px;width:100%;}.ds-input::placeholder{color:var(--faint);}.ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(max-width:680px){.ds-input{min-height:40px;}}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected navigation retains a quiet indigo tint.",
      "html": "<nav aria-label=\"Preview navigation\"><a class=\"ds-nav\" href=\"#applications\" aria-current=\"page\">Applications</a></nav>",
      "css": ".ds-nav{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;display:flex;gap:10px;padding:9px 11px;font-size:12px;font-weight:550;border-radius:5px;text-decoration:none;background:var(--accent-bg);color:var(--accent);}.ds-nav:hover{background:var(--surface-hover);color:var(--text);}.ds-nav:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Verified Status",
      "kind": "chip",
      "refersTo": "status-success",
      "description": "Read-only semantic label with icon, text, and tint.",
      "html": "<span class=\"ds-status\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m8 12 3 3 5-6\"/></svg>Verified</span>",
      "css": ".ds-status{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;display:inline-flex;align-items:center;gap:5px;border-radius:4px;font-size:10px;line-height:1.4;padding:3px 6px;white-space:nowrap;color:var(--success);background:var(--success-bg);}"
    },
    {
      "name": "Table Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat, bordered data container with a labeled keyboard scroll region.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-scroll\" role=\"region\" aria-label=\"Contract publications\" tabindex=\"0\"><table class=\"ds-table\"><thead><tr><th>Consumer</th><th>Provider</th></tr></thead><tbody><tr><td>checkout</td><td>catalog</td></tr></tbody></table></div></div>",
      "css": ".ds-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);overflow:hidden;}.ds-scroll{position:relative;overflow-x:auto;max-width:100%;}.ds-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:-3px;}.ds-table{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:11px;width:100%;border-collapse:collapse;text-align:left;white-space:nowrap;color:var(--text);font-variant-numeric:tabular-nums;}.ds-table th{padding:10px 16px;background:var(--surface-hover);font-size:10px;font-weight:450;color:var(--muted);border-bottom:1px solid var(--border);}.ds-table td{padding:15px 16px;}.ds-table tbody tr:hover{background:var(--surface-hover);}"
    },
    {
      "name": "JSON Panel",
      "kind": "custom",
      "description": "Syntax distinguishes inspectable code from the interface around it.",
      "html": "<div class=\"ds-json\"><pre tabindex=\"0\" aria-label=\"JSON content\">{\n  <span class=\"ds-key\">\"provider\"</span>: <span class=\"ds-string\">\"catalog\"</span>\n}</pre></div>",
      "css": ".ds-json{background:var(--code-bg);color:var(--text);border:1px solid var(--border);border-radius:6px;overflow:hidden;}.ds-json pre{font-family:\"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace;font-size:11px;line-height:1.8;max-height:530px;overflow:auto;padding:15px;margin:0;}.ds-key{color:var(--json-key);}.ds-string{color:var(--json-string);}.ds-json pre:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "The Broker Workspace",
    "overview": "Pact UI follows the user-pinned Linear, Vercel, and Datadog direction: a restrained developer workspace whose primary content is Broker evidence. Quiet neutral surfaces, persistent navigation, compact tables, and focused inspectors make relationships and deployment decisions legible.\n\nIndigo signals interaction and selection. Status colors communicate evidence with an icon and a written label. Light and dark modes preserve the same hierarchy. The system is code-first, with no decorative charts, gradients, or motion.",
    "keyCharacteristics": [
      "Compact, readable developer-tool density.",
      "Neutral surfaces with thin structural dividers.",
      "Quiet indigo interaction and explicit status labels.",
      "Keyboard access and responsive table containment."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Use status color only with a written label and an icon; unknown remains distinct from failed.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate ordinary content with tone and thin borders; reserve subtle shadows for controls, graph nodes, and the mobile drawer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the implemented light and dark semantic pairs together.",
      "Do keep technical identifiers in monospace and data numerals tabular.",
      "Do preserve visible focus, labeled scroll regions, and keyboard tab navigation.",
      "Do keep mobile controls at least 40px high and icon controls at least 40px wide."
    ],
    "donts": [
      "Don't use decorative charts, gradients, or motion.",
      "Don't communicate compatibility through color alone.",
      "Don't let wide tables force the whole page to scroll horizontally.",
      "Don't replace compact table structure with decorative card grids."
    ]
  }
}
