{
  "name": "pact-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node tools/build/standalone.mjs",
    "start": "node .next/standalone/server.js",
    "api:generate": "openapi-typescript openapi/pact-broker.yaml -o src/lib/api/schema.d.ts",
    "api:validate": "redocly lint openapi/pact-broker.yaml",
    "api:check": "node tools/openapi/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:coverage": "node tools/openapi/coverage.mjs",
    "api:assemble": "node tools/openapi/generate.mjs && npm run api:generate",
    "test:integration": "vitest run tests/broker.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:docker": "node tools/testing/real-docker.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@redocly/cli": "^2.8.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.8.0"
  },
  "type": "module"
}
